<%- layout('layout') -%>
<br><br>
<nav aria-label="breadcrumb" role="navigation">
      <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page" style="font-size:40px; font-weight:400">YOUR PROFILE</li>
        <!--<li style="float:right"><a href="/edit-profile/<%= user._id %>" class="btn btn-primary">Edit-Profile</a><li>-->
      </ol>
    </nav>

    <div class="container">
      <div class="row">
        <div class="col-md-3">
          <h4 style="color:#ff8101; font-weight:bold">Your Details</h4>
          <img src="<%= user.profile.photo %>" class="rounded-circle">
          <p><span class="det">Names:</span> <%= user.profile.fullname %></p>
          <p><span class="det">Email:</span> <%= user.email %></p>
          <p><span class="det">Phone Number:</span> <% if (user.profile.phone === "" || typeof user.profile.phone === 'undefined') { %>
            <%} else {%>
              <%= user.profile.phone %>
              <% } %></p>
          <p><span class="det">City:</span>
            <% if (user.profile.city === "" || typeof user.profile.city === 'undefined') { %>

              <%} else {%>
                <%= user.profile.city %>
                <% } %>
          </p>
          <p><span class="det">Street:</span>
            <% if (user.profile.street === "" || typeof user.profile.street === 'undefined') { %>

              <%} else {%>
                <%= user.profile.street %>
                <% } %>
          </p>
          <p><span class="det">Landmark:</span>
            <% if (user.profile.landmark === "" || typeof user.profile.landmark === 'undefined') { %>

              <%} else {%>
                <%= user.profile.landmark %>
                <% } %>
          </p>
          <a href="/edit-profile/<%= user._id %>" class="btn btn-primary">Edit-Profile</a>
        </div>


        <div class="col-md-5">
          <h4 style="color:#ff8101; font-weight:bold">Your Orders</h4>
          <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Item's Name</th>
                    <th scope="col">Paid</th>
                  </tr>
                </thead>
                <% for (var i = 0; i < user.history.length; i++) { %>
                <tbody>
                  <tr>
                    <td><%= user.history[i].item.title %></td>
                    <td><%= user.history[i].paid %></td>
                  </tr>
                </tbody>
                <% } %>
              </table>
        </div>
      </div>
    </div>
