<%- layout('layout') -%>
<div class="container">
     <div class="row">
       <div class="col-lg-4 log">
         <h1 style="text-align:center">Sign in</h1>
         <p style="text-align: center" class="help-block">New to Shoponfoods? <a href="/signup/" style="color: #FF0000">Sign up</a></p>

         <% if (message.length > 0) { %>
             <div class="alert alert-danger" role="alert">
                <%= message %>
             </div>
             <% } %>

             <a class="btn btn-secondary btn-block" href="/auth/facebook" style="height:45px; cursor:pointer">
               <img src="/img/FB-f-Logo__white_29.png" class="responsive" />Sign in with Facebook
             </a><br>
             <div class="goog">
               <a class="btn btn-secondary btn-block" href="/auth/google" style="height:45px; cursor:pointer">
                 <img src="/img/google.png" class="responsive jap" width="29px"/> Sign in with Google
               </a><br>
             </div>
         <form method="post">
           <div class="form-group">
             <input type="email" class="form-control"  placeholder="Email Address" name="email" style="height:50px">
           </div>
           <div class="form-group">
             <input type="password" class="form-control"  placeholder="Password" name="password" style="height:50px">
           </div>
           <button type="submit" class="btn btn-primary btn-block" style="height:45px; cursor:pointer">Log In</button>
         </form>
       </div>
     </div>
   </div>
