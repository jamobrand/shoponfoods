<%- layout('layout2') -%>
<!-- Masthead -->
<header class="masthead text-white text-center">
  <div class="overlay"></div>
  <div class="container">
    <div class="row">
      <div class="col-xl-9 mx-auto">
        <h1 class="mb-5">From the store to your doorstep in less than 24hrs!</h1>
      </div>
      <div class="col-md-10 col-lg-8 col-xl-7 mx-auto">
        <form>
          <div class="form-row">
            <div class="col-12 col-md-12 mb-4 mb-md-0 shoppping">
              <a href="/shop/" class="btn btn-lg btn-primary">Start Shopping</a>
            </div>
          </div>
