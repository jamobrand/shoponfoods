<%- layout('layout') -%>
<br><br>
    <div class="jumbotron">
       <div class="col-lg-6 mx-auto">
         <form method="post" action="/search">
         <div class="input-group">
           <input type="search" class="form-control" name="q" placeholder="Search for products.." aria-label="Search for products" style="height:45px;">
           <span class="input-group-btn">
             <button class="btn btn-primary" type="submit" style="height:45px;cursor:pointer">Go!</button>
           </span>
         </div>
       </form>
       </div>
     </div>

<div class="container">
  <div class="row">
    <div class="col-lg-3">
      <br>

      <div class="list-group">
        <a href="/shop" class="list-group-item">All Products</a>
        <% for (var i = 0; i < categories.length; i++) { %>
        <a href="/products/<%= categories[i]._id %>" class="list-group-item"><%= categories[i].title %></a>
        <% } %>
      </div>
  </div>

  <div class="col-lg-9 chop">
    <br>
    <% if (data.length === 0)  { %>
       <h3>Search not found</h3>
       <% } else {%>
         <h3>Results for <%= query %></h3>
    <div class="row">

      <% for (var i = 0; i < data.length; i++) { %>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100">
          <a href="/product/<%= data[i]._id %>"><img class="card-img-top" src="<%= data[i]._source.image %>" alt=""></a>
          <div class="card-body">
            <h5 class="card-title">
              <a href="/product/<%= data[i]._id %>"><%= data[i]._source.title %></a>
            </h5>
            <h5>Ksh <%= data[i]._source.price %></h5>
          </div>

        </div>
      </div>
        <% } %>


    </div>

  </div>
</div>
<% } %>
</div>

<br><br>
