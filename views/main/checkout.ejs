<%- layout('layout') -%>

<div class="container checkme">

  <div class="row">

    <div class="col-md-4 order-md-2 mb-4">
     <h4 class="d-flex justify-content-between align-items-center mb-3">
       <span class="text-muted">Your cart</span>
       <span class="badge badge-secondary">0</span>
     </h4>

     <ul class="list-group mb-3">
       <form method="post" action="/checkout">
      <% for (var i = 0; i < foundCart.items.length; i++) { %>
       <li class="list-group-item d-flex justify-content-between lh-condensed">
         <img class="order-image-my-gig" src="<%= foundCart.items[i].item.image %>" alt="" >
         <div>
           <input type="hidden" name="title" value="<%= foundCart.items[i].item.title %>"><%= foundCart.items[i].item.title %></input>
           <input type="hidden" name="quantity" value="<%= foundCart.items[i].quantity %>">(<%= foundCart.items[i].quantity %>)</input>

         </div>
         <input type="hidden" value="<%= foundCart.items[i].price %>">KSh <%= foundCart.items[i].price %></input>
         <!--<span class="text-muted">KSh 70</span>-->
       </li>
       <% } %>
       <li class="list-group-item d-flex justify-content-between">
         <span>Sub-Total :</span>
         <input type="hidden" name="total" value="<%= foundCart.total %>"><%= foundCart.total %></input>
         <!--<strong name="total"><%= foundCart.total %></strong>-->
       </li>

       <li class="list-group-item d-flex justify-content-between">
         <span>Delivery :</span>

           <% if( foundCart.total < 1000) { %>
            200
           <% } else { %>
            600
           <% } %>

       </li>

       <li class="list-group-item d-flex justify-content-between">
         <span>Total (KSH)</span>
         <% if( foundCart.total < 1000) { %>
           (200 + <%= foundCart.total %>)
         <% } else { %>
         <strong>600</strong> + <strong><%= foundCart.total %></strong>
         <% } %>
       </li>
     <!--</form>-->
     </ul>
   </div>


    <div class="col-md-8 order-md-2 laba">
      <h4 class="mb-3">Checkout Process</h4>
      <!--<form class="needs-validation" method="post">-->
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="firstName">First name</label>
            <input type="text" class="form-control" placeholder="" value="<%= user.profile.fname %>" name="fname" style="height:42px;" required>
            <div class="invalid-feedback">
              Valid first name is required.
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label for="lastName">Last name</label>
            <input type="text" class="form-control"  placeholder="" value="<%= user.profile.lname %>" name="lname" style="height:42px;" required>
            <div class="invalid-feedback">
              Valid last name is required.
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="email">Email</label>
          <input type="email" class="form-control" placeholder="you@example.com" style="height:42px;" value="<%= user.email %>" name="email">
          <div class="invalid-feedback">
            Please enter a valid email address for shipping updates.
          </div>
        </div>

        <div class="mb-3">
          <label for="telephone">Phone Number</label>
          <input type="tel" class="form-control" placeholder="0722000000" name="phone" value="" style="height:42px;" required>
          <div class="invalid-feedback">
            Please enter your phone number.
          </div>
        </div>

        <div class="row">
          <div class="col-md-5 mb-3">
            <label for="country">Delivery areas</label>
            <select class="custom-select d-block w-100"  name="area" value="" style="height:42px;" required>
              <option value="">Choose...</option>
              <option value="Ngong">Ngong</option>
              <option value="Westlands">Westlands</option>
              <option value="Garden Estate">Garden Estate</option>
              <option value="Kilimani">Kilimani</option>
              <option value="Muthaiga">Muthaiga</option>
            </select>
            <div class="invalid-feedback">
              Please select a valid area.
            </div>
          </div>
          <div class="col-md-4 mb-3">
            <label for="Landmark">Landmark</label>
            <input type="text" class="form-control"  placeholder="" style="height:42px;" name="landmark" value="" required>
            <div class="invalid-feedback">
              Landmark required.
            </div>
          </div>
          <div class="col-md-3 mb-3">
            <label for="street">Street Name/No</label>
            <input type="text" class="form-control" id="zip" placeholder="" style="height:42px;" name="street" value="" required>
            <div class="invalid-feedback">
              Street required.
            </div>
          </div>
        </div>

        <div class="mb-3">
          <labe>Special Instruction</label>
            <textarea class="form-control" rows="3" name="instruction" value="" placeholder="Special Instruction for your order
            E.g:Leave with the gateman or Call this No..."></textarea>

        </div>

        <hr class="mb-4">
        <button class="btn btn-primary btn-lg btn-block" type="submit">Continue to checkout</button>
      </form>
    </div>
  </div>
</div>
