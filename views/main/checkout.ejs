<%- layout('layout') -%>

<div class="container">

      <br><br><br><br>
     <div class="row">
       <div class="col-md-4 order-md-2 mb-4">
         <h4 class="d-flex justify-content-between align-items-center mb-3">
           <span class="text-muted">Your cart</span>
         </h4>
         <ul class="list-group mb-3">
           <form method="post" action="/checkout" class="needs-validation" novalidate>
             <% for (var i = 0; i < foundCart.items.length; i++) { %>
           <li class="list-group-item d-flex justify-content-between lh-condensed">
             <img class="order-image-my-gig" src="/product_images/<%= foundCart.items[i].item._id %>/<%= foundCart.items[i].item.image %>" alt="" >
             <div>
               <input type="hidden" name="title" value="<%= foundCart.items[i].item.title %>"><%= foundCart.items[i].item.title %></input>
               <input type="hidden" name="quantity" value="<%= foundCart.items[i].quantity %>">(<%= foundCart.items[i].quantity %>)</input>

             </div>
             <input type="hidden" value="<%= foundCart.items[i].price %>">KSh <%= foundCart.items[i].price %></input>
           </li>
           <% } %>
           <li class="list-group-item d-flex justify-content-between lh-condensed">
             <span>Sub-Total :</span>
             <input type="hidden" name="" value="<%= foundCart.total %>"><%= foundCart.total %></input>
           </li>
           <li class="list-group-item d-flex justify-content-between lh-condensed">
             <span>Delivery :</span>

             <% if(foundCart.total == 0) { %>
               <input type="hidden" name="" value="">0</input>
               <% } else if (foundCart.total < 1000) { %>
                 <input type="hidden" name="" value="">200</input>
                 <% } else { %>
                   <input type="hidden" name="" value="">400</input>
                   <% } %>
           </li>

           <li class="list-group-item d-flex justify-content-between bg-light">
             <span>Total (KSH)</span>
               <input type="hidden" name="total" value="<%= totalPrice %>"><%= totalPrice %></input>
           </li>
         </ul>
       </div>

       <div class="col-md-8 order-md-1">
         <h4 class="mb-3">Checkout Process</h4>
         <!--<form class="needs-validation" novalidate>-->
           <div class="mb-3">
             <label for="email">Full Name</label>
             <input type="text" class="form-control" style="height:42px;" value="<%= user.profile.fullname %>" name="fullname" required>
             <div class="invalid-feedback">
               Please enter a valid email address for shipping updates.
             </div>
           </div>

           <div class="mb-3">
             <label for="email">Email</label>
             <input type="email" class="form-control" placeholder="you@example.com" style="height:42px;" value="<%= user.email %>" name="email" required>
             <div class="invalid-feedback">
               Please enter a valid email address for shipping updates.
             </div>
           </div>

           <div class="mb-3">
             <label for="telephone">Phone Number</label>
               <% if (user.profile.phone === "" || typeof user.profile.phone === 'undefined') { %>
                 <input type="tel" class="form-control" placeholder="0722000000" name="phone" value="" style="height:42px;" required>
                 <%} else {%>
                      <input type="tel" class="form-control" placeholder="0722000000" name="phone" value="<%= user.profile.phone %>" style="height:42px;" required>
                   <% } %>
             <div class="invalid-feedback">
               Please enter your phone number.
             </div>
           </div>

           <div class="row">
             <div class="col-md-5 mb-3">
               <label for="country">Delivery areas</label>
               <select class="custom-select d-block w-100"  name="area" value="" style="height:42px;" required>
                 <option value="">Choose...</option>
                 <option value="Ngong">Ngong</option>
                 <option value="Westlands">Westlands</option>
                 <option value="Garden Estate">Garden Estate</option>
                 <option value="Kilimani">Kilimani</option>
                 <option value="Muthaiga">Muthaiga</option>
               </select>
               <div class="invalid-feedback">
                 Please select a valid area.
               </div>
             </div>
             <div class="col-md-4 mb-3">
               <label for="Landmark">Landmark</label>
               <% if (user.profile.city === "" || typeof user.profile.city === 'undefined') { %>
              <input type="text" class="form-control"  placeholder="" style="height:42px;" name="landmark" value="" required>
                 <%} else {%>
              <input type="text" class="form-control"  placeholder="" style="height:42px;" name="landmark" value="<%= user.profile.landmark %>" required>
                   <% } %>
               <div class="invalid-feedback">
                 Landmark required.
               </div>
             </div>
             <div class="col-md-3 mb-3">
               <label for="street">Street Name/No</label>
               <% if (user.profile.city === "" || typeof user.profile.city === 'undefined') { %>
            <input type="text" class="form-control" id="zip" placeholder="" style="height:42px;" name="street" value="" required>
                 <%} else {%>
             <input type="text" class="form-control" id="zip" placeholder="" style="height:42px;" name="street" value="<%= user.profile.street %>" required>
                   <% } %>
               <div class="invalid-feedback">
                 Street required.
               </div>
             </div>
           </div>
           <div class="mb-3">
             <label>Special Instruction</label>
             <textarea class="form-control" rows="3" name="instruction" value="" placeholder=""></textarea>
           </div>
           <hr class="mb-4">

           <button class="btn btn-primary btn-lg btn-block" type="submit">Continue to checkout</button>
         </form>
       </div>
     </div>
   </div>
