<%- layout('adminpanel') -%>
<div class="container">
  <div class="row">
    <div class="col-10 check">
      <a href="/admin/categories/add-category" class="btn btn-primary">Add Category</a>
    </div>
  </div>
</div>


<div class="container">
  <div class="row">
    <div class="col-10 view">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Category</th>
            <th scope="col">Edit</th>
            <th scope="col">Delete</th>
          </tr>
        </thead>
        <tbody>
          <% for (var i = 0; i < categories.length; i++)  { %>
          <tr>
            <td><%= categories[i].title %></td>
            <td><a href="/admin/categories/edit-category/<%= categories[i]._id %>">Edit</a></td>
            <td><a class="confirmDeletion" href="/delete-category/<%= categories[i]._id %>">Delete</a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
