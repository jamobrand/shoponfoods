<%- layout('adminpanel') -%>

<div class="container">
  <div class="row">
    <div class="col-11 view">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">User Picture</th>
            <th scope="col">Full Names</th>
            <th scope="col">Email</th>
            <th scope="col">Phone Number</th>
            <th scope="col">City</th>
            <th scope="col">Estate</th>
            <th scope="col">Street</th>
            <th scope="col">Apartment</th>
          </tr>
        </thead>
        <tbody>
         <% for (var i = 0; i < users.length; i++) { %>
          <tr>
            <td><img class="order-image-my-gig" src="<%= users[i].profile.photo %>"></td>
            <td><%= users[i].profile.fname %> <%= users[i].profile.lname %></td>
            <td><%= users[i].email %></td>
            <td><% if (users[i].profile.phone === "" || typeof users[i].profile.phone === 'undefined') { %>

              <%} else {%>
                <%= users[i].profile.phone %>
                <% } %>
              </td>
              <td><% if (users[i].profile.city === "" || typeof users[i].profile.city === 'undefined') { %>

                <%} else {%>
                  <%= users[i].profile.city %>
                  <% } %>
                </td>
                <td><% if (users[i].profile.estate === "" || typeof users[i].profile.estate === 'undefined') { %>

                  <%} else {%>
                    <%= users[i].profile.estate %>
                    <% } %>
                  </td>
                  <td><% if (users[i].profile.street === "" || typeof users[i].profile.street === 'undefined') { %>

                    <%} else {%>
                      <%= users[i].profile.street %>
                      <% } %>
                    </td>
                    <td><% if (users[i].profile.apartment === "" || typeof users[i].profile.apartment === 'undefined') { %>

                      <%} else {%>
                        <%= users[i].profile.apartment %>
                        <% } %>
                      </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
