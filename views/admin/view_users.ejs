<%- layout('adminpanel') -%>
<div class="content-wrapper">
  <div class="container-fluid">
    <!-- Breadcrumbs-->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a href="/admin">Dashboard</a>
      </li>
      <li class="breadcrumb-item active">Users</li>
    </ol>

    <!-- Example DataTables Card-->
      <div class="card mb-3">
        <div class="card-header">
          <i class="fa fa-table"></i> Data Table Example</div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
              <thead>
                <tr>
                  <th>User Image</th>
                  <th>Full Names</th>
                  <th>Email</th>
                  <th>Phone Number</th>
                  <th>Estate</th>
                  <th>Street</th>
                  <th>Apartment</th>
                </tr>
              </thead>
              <tfoot>
                <tr>
                  <th>User Image</th>
                  <th>Full Names</th>
                  <th>Email</th>
                  <th>Phone Number</th>
                  <th>Estate</th>
                  <th>Street</th>
                  <th>Apartment</th>
                </tr>
              </tfoot>
              <tbody>
           <% for (var i = 0; i < users.length; i++) { %>
            <tr>
              <td><img class="order-image-my-gig" src="<%= users[i].profile.photo %>"></td>
              <td><%= users[i].profile.fullname %></td>
              <td><%= users[i].email %></td>
              <td><% if (users[i].profile.phone === "" || typeof users[i].profile.phone === 'undefined') { %>

                <%} else {%>
                  <%= users[i].profile.phone %>
                  <% } %>
                </td>
                <td><% if (users[i].profile.city === "" || typeof users[i].profile.city === 'undefined') { %>

                  <%} else {%>
                    <%= users[i].profile.city %>
                    <% } %>
                  </td>
                  <td><% if (users[i].profile.estate === "" || typeof users[i].profile.estate === 'undefined') { %>

                    <%} else {%>
                      <%= users[i].profile.estate %>
                      <% } %>
                    </td>
                    <td><% if (users[i].profile.street === "" || typeof users[i].profile.street === 'undefined') { %>

                      <%} else {%>
                        <%= users[i].profile.street %>
                        <% } %>
                      </td>
                      <td><% if (users[i].profile.apartment === "" || typeof users[i].profile.apartment === 'undefined') { %>

                        <%} else {%>
                          <%= users[i].profile.apartment %>
                          <% } %>
                        </td>
            </tr>
            <% } %>
          </tbody>
            </table>
          </div>
        </div>
        <div class="card-footer small text-muted">Updated yesterday at 11:59 PM</div>


    </div>
  </div>
  <!-- /.container-fluid-->
  <!-- /.content-wrapper-->
