<%- layout('adminpanel') -%>

<div class="container">
  <div class="row">
    <div class="col-11 view">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">User Picture</th>
            <th scope="col">Full Names</th>
            <th scope="col">Email</th>
            <th scope="col">City</th>
            <th scope="col">Estate</th>
            <th scope="col">Street</th>
            <th scope="col">Apartment</th>
          </tr>
        </thead>
        <tbody>
        <% if (user) { %>
          <tr>
            <td><img class="order-image-my-gig" src="<%= user.profile.photo %>"></td>
            <td><%= user.profile.fname %> <%= user.profile.lname %></td>
            <td><%= user.email %></td>

          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
